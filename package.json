{
  "name": "voxora-reader",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "native:sync": "pnpm build && cap sync",
    "native:android": "pnpm native:sync && cap open android",
    "native:ios": "pnpm native:sync && cap open ios",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@google/genai": "2.10.0",
    "foliate-js": "1.0.1",
    "jszip": "3.10.1",
    "lucide-react": "^1.27.0",
    "mammoth": "1.12.0",
    "megajs": "^1.3.10",
    "mp4box": "^2.4.1",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tesseract.js": "5.1.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.18.0",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.18.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "vite": "8.1.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "2.1.9"
  }
}
