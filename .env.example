# Copy these names to Vercel Project Settings > Environment Variables.
# Never commit real values.
VOXORA_ADMIN_PASSWORD=replace-with-a-strong-password
VOXORA_ADMIN_SECRET=replace-with-a-long-random-secret

# Added automatically when Upstash Redis is connected through Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
